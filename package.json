{
  "name": "vcpeai-docs",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.17.1",
  "description": "Documentation for Video Controls Plus, a browser extension for video playback control.",
  "scripts": {
    "start": "docusaurus start --port 5912",
    "build": "NODE_OPTIONS=--no-experimental-webstorage docusaurus build && yarn seo:contract",
    "serve": "docusaurus serve --port 5912",
    "clear": "docusaurus clear",
    "write-translations": "docusaurus write-translations",
    "typecheck": "tsc",
    "seo:contract": "node plugins/seo-contract.ts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=26.13.1"
  }
}
