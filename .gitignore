# Dependencies
/node_modules

# Yarn (Berry): keep releases/plugins, ignore cache + state
/.yarn/*
!/.yarn/patches
!/.yarn/plugins
!/.yarn/releases
!/.yarn/versions
.pnp.*

# Docusaurus build output + cache (all recoverable)
/build
/.docusaurus
/.cache-loader

# Environment files never enter this public repository
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS and IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Other package managers' lockfiles (yarn only)
package-lock.json
pnpm-lock.yaml

# Standing ignores
*.ignore.*
project-record-ignore/
